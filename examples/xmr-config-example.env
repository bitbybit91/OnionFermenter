# Example configuration for OnionFermenter with Monero (XMR) support and Telegram notifications

# Required: Target onion service ID (without .onion suffix)
VICTIM_ONION_ID=juhanurmihxlp77nkq76byazcldy2hlmovfu2epvl5ankdibsot4csyd

# Required: Path to address file
# For XMR, create a file with Monero addresses (one per line)
ADDRESS_FILE=/path/to/your/xmr-addresses.txt

# Currency type: BTC (default), XMR, or MONERO
CURRENCY_TYPE=XMR

# Optional: Telegram bot configuration for real-time notifications
# To enable Telegram notifications:
# 1. Create a bot via @BotFather on Telegram
# 2. Get your bot token
# 3. Get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=987654321

# Number of replicas (Kubernetes only)
NREPLICAS=1
